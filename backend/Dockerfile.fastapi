FROM python:3.10-slim

# Install system dependencies including Tesseract OCR, Poppler (for PDFs), and OpenCV dependencies
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    poppler-utils \
    libgl1-mesa-glx \
    libglib2.0-0 \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install python packages (using root build context)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend files
COPY backend/ .

EXPOSE 8001

# Run FastAPI using Uvicorn
CMD ["uvicorn", "aml_compliance_service:app", "--host", "0.0.0.0", "--port", "8001"]
